{
  // The morsec marketing site: static files only, served by Workers Static Assets.
  "name": "morsec-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "morsec.motiontic.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
