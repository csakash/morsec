# Generated by scripts/release.sh from packaging/homebrew/morsec.rb.in. Do not edit by hand.
class Morsec < Formula
  desc "Local secret broker: coding agents use your secrets without seeing them"
  homepage "https://github.com/csakash/morsec"
  url "@URL@"
  version "@VERSION@"
  sha256 "@SHA256@"

  # Prebuilt, Developer ID signed and notarized binaries. Not built from source: the keychain
  # trusts only the signed msd (identifier cc.morsec.msd and the release team), so a local
  # build could not read the keys stored by the previous version.
  depends_on arch: :arm64
  depends_on :macos

  def install
    bin.install "bin/ms", "bin/msd"
    bin.install_symlink "ms" => "mors"
    (share/"morsec").install "share/morsec/BUILDINFO", "share/morsec/morsec.cdx.json"
  end

  def caveats
    <<~EOS
      Set morsec up (creates the vault and starts msd as a LaunchAgent):
        ms init
      morsec has no auto-update. Upgrade with: brew upgrade morsec
    EOS
  end

  test do
    assert_match "morsec #{version}", shell_output("#{bin}/ms --version")
    assert_match "morsec #{version}", shell_output("#{bin}/mors --version")
  end
end
