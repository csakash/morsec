{
  "worktreeDir": "worktrees",
  "branchPrefix": "feat/",
  "portStride": 100,
  "repos": [
    {
      "name": "morsec",
      "path": ".",
      "baseBranch": "main",
      "basePort": 4000,
      "dev": [
        "cargo",
        "run",
        "-q",
        "-p",
        "msd",
        "--",
        "--foreground",
        "--port",
        "{{port}}"
      ],
      "env": {}
    }
  ],
  "review": {
    "fixCycles": 2,
    "security": true,
    "sensitivePaths": [
      ".github/workflows/**",
      ".gitlab-ci.yml",
      ".circleci/**",
      "Jenkinsfile",
      "CODEOWNERS",
      ".github/CODEOWNERS",
      "**/auth/**",
      "**/billing/**",
      "**/payments/**",
      "**/migrations/**",
      "setup",
      "**/install*",
      "**/vault/**",
      "**/broker/**",
      "**/keychain/**",
      "crates/ms-vault/**",
      "crates/ms-proxy/**",
      "crates/ms-run/**",
      "crates/ms-approve/**",
      "crates/ms-rules/**",
      "crates/ms-ipc/**",
      "apps/MorsecApprove/**",
      "deny.toml",
      "rust-toolchain.toml",
      "scripts/check.sh",
      "package.json"
    ]
  },
  "hooks": {
    "preLoop": null,
    "postShip": null
  }
}
